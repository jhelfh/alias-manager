#!/bin/bash
set -euo pipefail
backend=/usr/lib/alias-manager/alias-manager-core
config="${XDG_CONFIG_HOME:-$HOME/.config}/alias-manager"
if [[ ! -t 0 || ! -t 1 ]]; then
    printf '%s\n' 'alias-manager: interactive mode requires a terminal.' >&2
    exit 1
fi
if [[ ${EUID} == 0 ]]; then
    printf '%s\n' 'Do not run Alias Manager as root.' >&2
    exit 1
fi
mkdir -p -- "$config"
chmod 700 -- "$config"
trap 'printf "\033[?25h\033[0m\033[0 q"' EXIT
block='source /usr/share/alias-manager/bash-integration.sh'
if [[ ! -f "$config/setup-v1" ]] || ! grep -Fq "$block" "$HOME/.bashrc" 2>/dev/null; then
    printf '\033[1;92m\n  ALIAS MANAGER — FIRST RUN\033[0m\n\n'
    printf '%s\n' '  Enable automatic aliases for your Bash account?' \
      '  This backs up and updates ~/.bashrc.' \
      '  Other shells (Zsh, Fish) are not supported.' \
      '  Reopen existing Bash terminals once after setup.' ''
    read -r -p '  Enable? [y/N] > ' answer || exit 0
    if [[ ${answer,,} == y || ${answer,,} == yes ]]; then
        if [[ -L "$HOME/.bashrc" ]]; then
            printf '%s\n' 'Symlinked .bashrc is not modified automatically.'
            read -r -p 'Press Enter to close... ' _ || true
            exit 1
        fi
        touch -- "$HOME/.bashrc"
        backup="$HOME/.bashrc.alias-manager-backup.$(date +%Y%m%d-%H%M%S).$$"
        cp -p -- "$HOME/.bashrc" "$backup"
        temporary=$(mktemp "$HOME/.bashrc.alias-manager.XXXXXX")
        trap 'rm -f -- "${temporary:-}"; printf "\033[?25h\033[0m\033[0 q"' EXIT
        awk '
        $0 == "# >>> alias-manager integration >>>" { skip=1; next }
        $0 == "# <<< alias-manager integration <<<" { skip=0; next }
        !skip { print }
        END { if (skip) exit 1 }
        ' "$HOME/.bashrc" > "$temporary"
        cat >> "$temporary" <<'BLOCK'

# >>> alias-manager integration >>>
if [[ -r /usr/share/alias-manager/bash-integration.sh ]]; then
    source /usr/share/alias-manager/bash-integration.sh
fi
# <<< alias-manager integration <<<
BLOCK
        chmod --reference="$HOME/.bashrc" "$temporary"
        mv -- "$temporary" "$HOME/.bashrc"
        printf 'enabled\n' > "$config/setup-v1"
        printf '\n  Enabled. Reopen existing Bash terminals once.\n'
        read -r -p '  Press Enter to open the manager... ' _ || exit 0
    else
        printf '\n  Integration remains disabled. You can manage records.\n'
        read -r -p '  Press Enter to continue... ' _ || exit 0
    fi
fi
status=0
"$backend" || status=$?
if (( status != 0 )); then
    printf '\nAlias Manager exited with status %s.\n' "$status"
    read -r -p 'Press Enter to close... ' _ || true
fi
exit "$status"
